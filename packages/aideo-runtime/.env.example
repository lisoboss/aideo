# Runtime HTTP service bind address
AIDEO_RUNTIME_HOST=127.0.0.1
AIDEO_RUNTIME_PORT=9090

# Development only: include Python tracebacks in JSON and SSE error responses.
# Never enable this on an untrusted network.
AIDEO_RUNTIME_DEBUG=false

# Comma-separated provider modules loaded from backend/providers/.
# Keep demo for HTTP contract verification; Linux GPU deployments can enable
# ltx2 and faster_whisper2: demo,ltx2,faster_whisper2
AIDEO_RUNTIME_PROVIDERS=demo

# ComfyUI-style shared roots. Providers resolve model, input, and output paths
# only below these directories. API output references use runtime://output/...
AIDEO_RUNTIME_MODELS_DIR=./models
# Legacy deployments can keep using AIDEO_MODEL_ROOT when the variable above
# is unset, for example: AIDEO_MODEL_ROOT=/mnt/g/AI/models
AIDEO_RUNTIME_INPUT_DIR=./data/input
AIDEO_RUNTIME_OUTPUT_DIR=./data/output

# Faster-Whisper2 (provider=faster_whisper2, implementation: aideo-models).
# This must be an existing local model directory relative to
# AIDEO_RUNTIME_MODELS_DIR; no model download is attempted.
WHISPER_MODEL=whisper/large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# LTX-2 (provider=ltx2, implementation: aideo-models). Every value is a path
# relative to MODELS_DIR.
LTX2_DISTILLED_CHECKPOINT=ltx2/ltx-2.3-22b-distilled.safetensors
LTX2_GEMMA_ROOT=ltx2/gemma-3-12b-it
LTX2_SPATIAL_UPSAMPLER=ltx2/ltx-2.3-spatial-upscaler.safetensors
LTX2_DEVICE=cuda
LTX2_QUANTIZATION=fp8-cast
LTX2_OFFLOAD_MODE=none
# LTX2_LORA=ltx2/optional-lora.safetensors
# LTX2_LORA_STRENGTH=1.0
